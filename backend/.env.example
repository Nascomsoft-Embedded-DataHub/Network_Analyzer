# ---- Network Analyser backend ----
# Copy to .env and adjust for your machine.

NODE_ENV=development

# Interface the API binds to.
#
# Keep this on 127.0.0.1 while only the laptop's own browser needs the API.
#
# Set it to 0.0.0.0 ONLY if the Android phone must reach the API over the
# local network. The device inventory is then protected by the session below,
# but every device on the network can still reach the sign-in screen, so keep
# the administrator password strong and use a network you trust.
HOST=127.0.0.1
PORT=3000

# PostgreSQL connection string used by the ingestion pipeline and migrations.
#
# The project's container publishes on 5433 by default, so that it does not
# collide with a PostgreSQL you may already be running on 5432. If you move
# the published port (`DB_PORT=5434 docker compose up -d db`), point this at
# the same one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/network_analyser

# Comma-separated list of origins permitted to call the API.
# The Android phone's browser will report its own origin when it loads the
# dashboard, so include that too (e.g. http://192.168.1.24:5173).
CORS_ORIGIN=http://localhost:5173

# ---- Discovery ----

# Comma-separated list of discovery sources the ingestion listener polls.
#
# - neighbour-cache  the host OS ARP/neighbour cache. Reports true hardware
#                    addresses, but only for devices this machine has spoken to.
# - starlink-router  the router's client roster, read over its local gRPC
#                    control plane. Reports every attached device, but masks
#                    the low three octets of each MAC down to the vendor OUI.
# - simulated        a synthetic roster for demos and tests. Never enable this
#                    on a live network: it writes devices that do not exist.
#
# Run both of the first two on a real network: each covers the other's blind
# spot. See docs/adr/0002-device-identity.md.
DISCOVERY_SOURCES=neighbour-cache,starlink-router

# Seconds between discovery polls.
DISCOVERY_POLL_INTERVAL_SECONDS=15

# Seconds of silence after which a device is marked offline.
DISCOVERY_OFFLINE_AFTER_SECONDS=180

# Address and control-plane port of the Starlink router.
STARLINK_ROUTER_HOST=192.168.1.1
STARLINK_ROUTER_PORT=9000

# ---- Telemetry ----

# Seconds between writes of the hourly usage buckets.
#
# The buckets themselves are hourly; this is how often the pending traffic
# is handed over. Shorter intervals make the current hour appear on the
# dashboard sooner, at the cost of more writes.
TELEMETRY_USAGE_FLUSH_INTERVAL_SECONDS=300

# Seconds between health samples.
#
# Each sample asks the router to run its own speed test, which is real
# traffic on the link. A sample every five minutes is enough for the
# dashboard without spending the link on measurement.
TELEMETRY_HEALTH_INTERVAL_SECONDS=300

# Days of hourly usage rollups to keep.
#
# Seven days is the window the consumption dashboards cover, and the
# privacy directives allow exactly that long.
TELEMETRY_USAGE_RETENTION_DAYS=7

# Days of health samples to keep.
TELEMETRY_HEALTH_RETENTION_DAYS=7

# Seconds between retention sweeps.
TELEMETRY_RETENTION_INTERVAL_SECONDS=3600

# ---- Sessions ----

# Address of the administrator account.
#
# The analyser keeps its accounts here rather than in a user table: there is
# one administrator and, optionally, one read-only viewer.
ANALYSER_ADMIN_EMAIL=admin@analyser.local

# Password of the administrator account.
#
# Leave it empty and the analyser still runs and still serves the sign-in
# screen, but nobody can sign in — the dashboard says so rather than
# rejecting every attempt as a wrong password. Use at least 8 characters.
ANALYSER_ADMIN_PASSWORD=

# Address and password of the optional read-only account.
#
# A viewer sees every figure on the dashboard and can change nothing: not
# which devices are known, not which alerts are acknowledged, not the alert
# rules. Both must be set for the account to exist.
ANALYSER_VIEWER_EMAIL=
ANALYSER_VIEWER_PASSWORD=

# Secret used to sign session tokens.
#
# Without one, a random secret is generated at boot and every session stops
# working when the analyser restarts. A fixed value means the phone keeps its
# session across a restart. Use at least 16 characters.
ANALYSER_SESSION_SECRET=

# How long a session lasts, in hours.
ANALYSER_SESSION_TTL_HOURS=12
