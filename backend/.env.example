# ---- Network Analyser backend ----
# Copy to .env and adjust for your machine.

NODE_ENV=development

# Interface the API binds to.
#
# Keep this on 127.0.0.1 while only the laptop's own browser needs the API.
#
# Set it to 0.0.0.0 ONLY if the Android phone must reach the API over the
# local network. Session authentication is not implemented yet, so binding
# beyond loopback exposes the device inventory to every device on the
# network. Use a trusted network, and prefer an SSH tunnel or reverse proxy
# with authentication until the auth work lands.
HOST=127.0.0.1
PORT=3000

# PostgreSQL connection string used by the ingestion pipeline and migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_analyser

# Comma-separated list of origins permitted to call the API.
# The Android phone's browser will report its own origin when it loads the
# dashboard, so include that too (e.g. http://192.168.1.24:5173).
CORS_ORIGIN=http://localhost:5173
