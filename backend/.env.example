# ---- Network Analyser backend ----
# Copy to .env and adjust for your machine.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string used by the ingestion pipeline and migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_analyser

# Comma-separated list of origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173
