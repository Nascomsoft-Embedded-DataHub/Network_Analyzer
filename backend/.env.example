# ---- Network Analyser backend ----
# Copy to .env and adjust for your machine.

NODE_ENV=development

# Interface the API binds to.
#
# Keep this on 127.0.0.1 while only the laptop's own browser needs the API.
#
# Set it to 0.0.0.0 ONLY if the Android phone must reach the API over the
# local network. Session authentication is not implemented yet, so binding
# beyond loopback exposes the device inventory to every device on the
# network. Use a trusted network, and prefer an SSH tunnel or reverse proxy
# with authentication until the auth work lands.
HOST=127.0.0.1
PORT=3000

# PostgreSQL connection string used by the ingestion pipeline and migrations.
#
# If your machine already runs PostgreSQL on 5432, publish the project's
# container on another port (`DB_PORT=5433 docker compose up -d db`) and point
# this at that port.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_analyser

# Comma-separated list of origins permitted to call the API.
# The Android phone's browser will report its own origin when it loads the
# dashboard, so include that too (e.g. http://192.168.1.24:5173).
CORS_ORIGIN=http://localhost:5173

# ---- Discovery ----

# Comma-separated list of discovery sources the ingestion listener polls.
#
# - neighbour-cache  the host OS ARP/neighbour cache. Reports true hardware
#                    addresses, but only for devices this machine has spoken to.
# - starlink-router  the router's client roster, read over its local gRPC
#                    control plane. Reports every attached device, but masks
#                    the low three octets of each MAC down to the vendor OUI.
# - simulated        a synthetic roster for demos and tests. Never enable this
#                    on a live network: it writes devices that do not exist.
#
# Run both of the first two on a real network: each covers the other's blind
# spot. See docs/adr/0002-device-identity.md.
DISCOVERY_SOURCES=neighbour-cache,starlink-router

# Seconds between discovery polls.
DISCOVERY_POLL_INTERVAL_SECONDS=15

# Seconds of silence after which a device is marked offline.
DISCOVERY_OFFLINE_AFTER_SECONDS=180

# Address and control-plane port of the Starlink router.
STARLINK_ROUTER_HOST=192.168.1.1
STARLINK_ROUTER_PORT=9000
